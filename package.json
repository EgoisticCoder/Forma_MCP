{
  "name": "@forma-ai/forma-mcp",
  "version": "0.5.0",
  "description": "Portable Playwright MCP server for UI/UX audits: inspect pages, capture screenshots, measure accessibility, performance, color, motion, and responsive layouts with user-controlled browser actions.",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "forma-mcp": "dist/src/index.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "license": "MIT",
  "homepage": "https://forma-mcp-website.vercel.app/",
  "keywords": ["forma", "mcp", "model-context-protocol", "playwright", "browser-automation", "ui-ux", "website-audit", "accessibility", "lighthouse", "axe-core"],
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "https://github.com/EgoisticCoder/Forma_MCP.git" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "node --test dist/test/*.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "axe-core": "^4.10.3",
    "playwright": "^1.55.0",
    "sharp": "^0.34.3",
    "zod": "^3.25.0"
  },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.8.0" }
}
